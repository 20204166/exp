{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "railrefund": {
      "type": "local",
      "command": ["python", "-m", "tools.railrefund_mcp.server", "--repo-root", "/root/railrefund"],
      "enabled": true
    }
  },
  "agent": {
    "bugguard-main": {
      "mode": "primary",
      "model": "opencode-go/qwen3.7-max",
      "temperature": 0.1,
      "permission": {
        "task": {
          "*": "deny",
          "bugguard-opposer-*": "allow",
          "bugguard-agent5": "allow"
        }
      }
    },
    "bugguard-main-paid": {
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "temperature": 0.2,
      "permission": {
        "task": {
          "*": "deny",
          "bugguard-opposer-*": "allow",
          "bugguard-agent5": "allow"
        }
      }
    },
    "bugguard-main-openai": {
      "mode": "primary",
      "model": "openai/gpt-5.4-mini",
      "temperature": 0.2,
      "permission": {
        "task": {
          "*": "deny",
          "bugguard-opposer-*": "allow",
          "bugguard-agent5": "allow"
        }
      }
    },
    "compliance-main": {
      "mode": "primary",
      "model": "deepseek/deepseek-v4-flash-free",
      "temperature": 0.1,
      "permission": {
        "task": {
          "*": "deny",
          "compliance-reviewer-*": "allow",
          "compliance-evidence-auditor": "allow"
        }
      }
    },
    "compliance-main-paid": {
      "mode": "primary",
      "model": "opencode/deepseek-v4-pro",
      "temperature": 0.1,
      "permission": {
        "task": {
          "*": "deny",
          "compliance-reviewer-*": "allow",
          "compliance-evidence-auditor": "allow"
        }
      }
    },
    "compliance-main-openai": {
      "mode": "primary",
      "model": "openai/gpt-5.4-mini",
      "temperature": 0.2,
      "permission": {
        "task": {
          "*": "deny",
          "compliance-reviewer-*": "allow",
          "compliance-evidence-auditor": "allow"
        }
      }
    }
  }
}
